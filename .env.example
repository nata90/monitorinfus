# Salin ke .env lalu sesuaikan. File .env tidak masuk repository.

# --- Database: container MySQL yang sudah ada ---
# Dipakai saat aplikasi/CLI berjalan di mesin host (mis. `php yii migrate` dari Mac):
#   host 127.0.0.1 + port yang di-publish container mysql (3309 -> 3306)
DB_HOST=127.0.0.1
DB_PORT=3309
# Dipakai otomatis saat aplikasi berjalan DI DALAM container (terdeteksi /.dockerenv),
# mis. container webapp yang me-mount folder ini. Pilihan:
#   host.docker.internal:3309  (Docker Desktop)  atau  <IP/nama container mysql>:3306
DB_HOST_DOCKER=host.docker.internal
DB_PORT_DOCKER=3309
DB_NAME=infus
DB_USER=root
DB_PASSWORD=

# --- Aplikasi ---
APP_TIMEZONE=Asia/Jakarta
COOKIE_VALIDATION_KEY=ganti-dengan-string-acak-minimal-32-karakter
# true  : URL mengandung index.php (tidak perlu mod_rewrite / .htaccess)
# false : URL bersih, butuh mod_rewrite + AllowOverride All
URL_SHOW_SCRIPT_NAME=true
YII_DEBUG=true
YII_ENV=dev
